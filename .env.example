# Supabase: setzt die Vercel↔Supabase-Integration automatisch
# (NEXT_PUBLIC_SUPABASE_URL, SUPABASE_SECRET_KEY). Nur ohne Integration von Hand:
# SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=

# Langer Zufallsstring, signiert die Login-Session (JWT).
# Erzeugen z. B. mit: openssl rand -base64 32
SESSION_SECRET=

# Feste Login-Passwörter, je eines pro Person.
INTERN_PASSWORD_MARCO=
INTERN_PASSWORD_TOBI=
