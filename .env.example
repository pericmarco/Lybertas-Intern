# Eigenes Supabase-Projekt nur für dieses Dashboard (nicht das Lybertas-Produkt):
# Project Settings → API → Project URL bzw. service_role-Key.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Langer Zufallsstring, signiert die Login-Session (JWT).
# Erzeugen z. B. mit: openssl rand -base64 32
SESSION_SECRET=

# Feste Login-Passwörter, je eines pro Person.
INTERN_PASSWORD_MARCO=
INTERN_PASSWORD_TOBI=
